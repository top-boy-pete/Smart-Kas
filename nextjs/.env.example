# Next.js exposes only NEXT_PUBLIC_* variables to the browser.
# This mirrors the original Vite VITE_* variables (VITE_SUPABASE_URL -> NEXT_PUBLIC_SUPABASE_URL, etc).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Set to "false" to disable the preview/demo mode even when Supabase is not configured.
NEXT_PUBLIC_DEMO_MODE=true

# Configure these as Supabase Edge Function secrets, not Vercel/NEXT_PUBLIC variables.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
CLOUDINARY_PRODUCT_UPLOAD_PRESET=kasua-merchant-product-signed
CLOUDINARY_DOCUMENT_UPLOAD_PRESET=kasua-merchant-documents-signed
CLOUDINARY_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain
