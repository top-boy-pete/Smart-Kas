VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Configure these as Supabase Edge Function secrets, not Vercel/VITE variables.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
CLOUDINARY_PRODUCT_UPLOAD_PRESET=kasua-merchant-product-signed
CLOUDINARY_DOCUMENT_UPLOAD_PRESET=kasua-merchant-documents-signed
CLOUDINARY_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain
